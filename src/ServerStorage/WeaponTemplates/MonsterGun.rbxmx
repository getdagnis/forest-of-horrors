		<Item class="LocalScript" referent="RBXa853f71ebdc448b68a69d8ada6359952">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Client script for MonsterGun
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local tool = script.Parent
local shootEvent = tool:WaitForChild("ShootEvent")
local MonsterManager = require(game:GetService("ReplicatedStorage"):WaitForChild("MonsterManager"))

local GUNSHOT_SOUND = "rbxassetid://138074730724614"

-- Walk up the ancestor chain to find a Humanoid (handles nested monster structures)
local function findHumanoid(part)
	local current = part
	while current do
		local hum = current:FindFirstChildOfClass("Humanoid")
		if hum then return hum end
		current = current.Parent
	end
	return nil
end

-- True only while the tool is actually equipped (parented to a character)
local function isEquipped()
	local parent = tool.Parent
	return parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Play a gunshot sound from the handle
local function playSound()
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local sound = handle:FindFirstChild("GunshotSound")
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "GunshotSound"
		sound.SoundId = GUNSHOT_SOUND
		sound.Volume = 0.6
		sound.Parent = handle
	end
	sound:Play()
end

-- Spawn a brief muzzle flash at the barrel tip
local function muzzleFlash()
	local barrel = tool:FindFirstChild("Barrel")
	if not barrel then return end

	local flash = Instance.new("Part")
	flash.Name = "MuzzleFlash"
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(1, 1, 1)
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 105, 180)
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false

	local light = Instance.new("SpotLight")
	light.Color = Color3.fromRGB(255, 105, 180)
	light.Brightness = 5
	light.Range = 24
	light.Parent = flash

	flash.CFrame = barrel.CFrame * CFrame.new(0, 0, -barrel.Size.Z / 2 - 0.4)
	flash.Parent = workspace

	task.delay(0.06, function()
		flash:Destroy()
	end)
end


local Debris = game:GetService("Debris")

local function showShotBeam(mouse)
	local barrel = tool:FindFirstChild("Barrel") or handle
	if not barrel:IsA("BasePart") then
		return
	end

	local origin = barrel.Position
	local direction = mouse.Hit.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {player.Character, tool}
	params.IgnoreWater = true

	local result = workspace:Raycast(origin, direction, params)
	local hitPosition = result and result.Position or mouse.Hit.Position

	local endPart = Instance.new("Part")
	endPart.Name = "ShotBeamEnd"
	endPart.Anchored = true
	endPart.CanCollide = false
	endPart.CanQuery = false
	endPart.CanTouch = false
	endPart.Transparency = 1
	endPart.Size = Vector3.new(0.1, 0.1, 0.1)
	endPart.Position = hitPosition
	endPart.Parent = workspace

	local startAttachment = Instance.new("Attachment")
	startAttachment.Parent = barrel

	local endAttachment = Instance.new("Attachment")
	endAttachment.Parent = endPart

	local beam = Instance.new("Beam")
	beam.Attachment0 = startAttachment
	beam.Attachment1 = endAttachment
	beam.FaceCamera = true
	beam.Width0 = 0.14
	beam.Width1 = 0.06
	beam.LightEmission = 1
	beam.Color = ColorSequence.new(Color3.fromRGB(100, 255, 120))
	beam.Parent = barrel

	Debris:AddItem(startAttachment, 0.08)
	Debris:AddItem(endPart, 0.08)
end

local mouse = player:GetMouse()

mouse.Button1Down:Connect(function()
	if not isEquipped() then return end

	local handle = tool:FindFirstChild("Handle")
	if not handle then return end

	-- Always give shot feedback (sound + muzzle flash)
	playSound()
	muzzleFlash()
	showShotBeam(mouse)

	local target = mouse.Hit.Position
	local direction = (target - handle.Position).unit

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {player.Character, tool}

	local result = workspace:Raycast(handle.Position, direction * 300, params)
	if result then
		shootEvent:FireServer(result.Instance)
	end
end)
]]></ProtectedString>
