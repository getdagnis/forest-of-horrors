		<Item class="LocalScript" referent="RBX73c0ff072e114d75a8b55288f261567e">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- MonsterBlaster ClientScript
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local tool = script.Parent
local shootEvent = tool:WaitForChild("ShootEvent")

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local RANGE = 350
local CHARGE_TIME = 5
local COOLDOWN = 2

local chargeStartedAt = 0
local chargePulseToken = 0
local cooldownStartedAt = 0

local GUNSHOT_SOUND = "rbxassetid://131794614393147"
local CHARGE_SOUND = "rbxassetid://140102991925260"
local COOLDOWN_SOUND = "rbxassetid://108221299985037"

local charging = false
local charged = false
local coolingDown = false
local chargeSoundInstance = nil

local function isEquipped()
	local parent = tool.Parent
	return parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") ~= nil
end

local function getHandle()
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		return handle
	end
	return nil
end

local function getBarrel()
	local barrel = tool:FindFirstChild("Barrel")
	if barrel and barrel:IsA("BasePart") then
		return barrel
	end

	return getHandle()
end

local function playShotSound(chargeRatio)
	local handle = getHandle()
	if not handle then return end

	local sound = handle:FindFirstChild("GunshotSound")
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "GunshotSound"
		sound.SoundId = GUNSHOT_SOUND
		sound.Parent = handle
	end

	sound.Volume = 0.5 + (2.5 * chargeRatio)
	sound.PlaybackSpeed = math.random(95, 105) / 100
	sound:Play()
end

local function startChargeSound()
	local handle = getHandle()
	if not handle then return end
	if CHARGE_SOUND == "" then return end

	local sound = handle:FindFirstChild("ChargeSound")
	
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "ChargeSound"
		sound.SoundId = CHARGE_SOUND
		sound.Volume = 1.4
		sound.Parent = handle
	end

	chargeSoundInstance = sound
	sound.Looped = false
	sound.TimePosition = 0
	sound:Play()
end

local function stopChargeSound()
	if chargeSoundInstance then
		chargeSoundInstance:Stop()
	end
end

local function playCooldownSound()
	local handle = getHandle()
	if not handle then return end

	local sound = handle:FindFirstChild("CooldownSound")
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "CooldownSound"
		sound.SoundId = COOLDOWN_SOUND
		sound.Volume = 1
		sound.Parent = handle
	end

	sound:Play()
end

local function setHandleMaterial(material)
	local handle = getHandle()
	if handle then
		handle.Material = material
	end
end

local function startHandlePulse()
	chargePulseToken += 1
	local token = chargePulseToken

	task.spawn(function()
		while charging and not charged and token == chargePulseToken do
			setHandleMaterial(Enum.Material.Neon)
			task.wait(0.12)

			if not charging or charged or token ~= chargePulseToken then
				break
			end

			setHandleMaterial(Enum.Material.Metal)
			task.wait(0.12)
		end

		if charging and charged and token == chargePulseToken then
			setHandleMaterial(Enum.Material.Neon)
		end
	end)
end

local function stopHandlePulse(finalMaterial)
	chargePulseToken += 1
	setHandleMaterial(finalMaterial or Enum.Material.Metal)
end

local function getChargeRatio()
	if chargeStartedAt <= 0 then
		return 0
	end

	return math.clamp((os.clock() - chargeStartedAt) / CHARGE_TIME, 0, 1)
end

local HUD_WIDTH = 360
local HUD_HEIGHT = 8

local EMPTY_COLOR = Color3.fromRGB(17, 53, 59)
local READY_COLOR = Color3.fromRGB(65, 115, 128)
local FULL_COLOR = Color3.fromRGB(67, 207, 255)

local playerGui = player:WaitForChild("PlayerGui")

local chargeGui = playerGui:FindFirstChild("MonsterBlasterChargeHud")
if not chargeGui then
	chargeGui = Instance.new("ScreenGui")
	chargeGui.Name = "MonsterBlasterChargeHud"
	chargeGui.ResetOnSpawn = false
	chargeGui.IgnoreGuiInset = true
	chargeGui.Enabled = false
	chargeGui.Parent = playerGui
end

local chargeBack = chargeGui:FindFirstChild("ChargeBack")
if not chargeBack then
	chargeBack = Instance.new("Frame")
	chargeBack.Name = "ChargeBack"
	chargeBack.AnchorPoint = Vector2.new(0.5, 1)
	chargeBack.Position = UDim2.new(0.5, 0, 1, -92)
	chargeBack.Size = UDim2.fromOffset(HUD_WIDTH, HUD_HEIGHT)
	chargeBack.BackgroundColor3 = EMPTY_COLOR
	chargeBack.BorderSizePixel = 0
	chargeBack.Parent = chargeGui
end

local chargeFill = chargeBack:FindFirstChild("ChargeFill")
if not chargeFill then
	chargeFill = Instance.new("Frame")
	chargeFill.Name = "ChargeFill"
	chargeFill.Size = UDim2.new(0, 0, 1, 0)
	chargeFill.BackgroundColor3 = READY_COLOR
	chargeFill.BorderSizePixel = 0
	chargeFill.Parent = chargeBack
end

local function easeOutCubic(value)
	value = math.clamp(value, 0, 1)
	return 1 - ((1 - value) ^ 3)
end

local function setChargeHud(progress, color)
	progress = math.clamp(progress, 0, 1)
	chargeFill.Size = UDim2.new(progress, 0, 1, 0)
	chargeFill.BackgroundColor3 = color
end

RunService.RenderStepped:Connect(function()
	if not chargeGui.Enabled then return end

	if charging then
		local rawProgress = getChargeRatio()
		local progress = easeOutCubic(rawProgress)
		local color = READY_COLOR:Lerp(FULL_COLOR, progress)

		if charged then
			setChargeHud(1, FULL_COLOR)
		else
			setChargeHud(progress, color)
		end

		return
	end

	if coolingDown then
		local rawProgress = (os.clock() - cooldownStartedAt) / COOLDOWN
		local progress = easeOutCubic(rawProgress)
		local color = EMPTY_COLOR:Lerp(READY_COLOR, progress)

		setChargeHud(progress, color)
		return
	end

	setChargeHud(1, READY_COLOR)
end)

local function muzzleFlash(chargeRatio)
	local barrel = getBarrel()
	if not barrel then return end

	local flash = Instance.new("Part")
	local flashSize = 0.5 + (2.5 * chargeRatio)
	flash.Size = Vector3.new(flashSize, flashSize, flashSize)
	flash.Name = "BlasterMuzzleFlash"
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(62, 169, 255)
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.CFrame = barrel.CFrame * CFrame.new(0, 0, -barrel.Size.Z / 2 - 0.6)
	flash.Parent = workspace

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(62, 169, 255)
	light.Brightness = 30 * chargeRatio
	light.Range = 80 * chargeRatio
	light.Shadows = true
	light.Parent = flash

	Debris:AddItem(flash, 0.12)
end



local function makeRaycastParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, tool }
	params.IgnoreWater = true
	return params
end

local function showShotBeam(originPart, hitPosition, chargeRatio)
	local barrel = getBarrel() or originPart
	if not barrel then return end

	local endPart = Instance.new("Part")
	endPart.Name = "BlasterBeamEnd"
	endPart.Anchored = true
	endPart.CanCollide = false
	endPart.CanQuery = false
	endPart.CanTouch = false
	endPart.Transparency = 1
	endPart.Size = Vector3.new(0.2, 0.2, 0.2)
	endPart.Position = hitPosition
	endPart.Parent = workspace

	local startAttachment = Instance.new("Attachment")
	startAttachment.Parent = barrel

	local endAttachment = Instance.new("Attachment")
	endAttachment.Parent = endPart

	local beam = Instance.new("Beam")
	beam.Attachment0 = startAttachment
	beam.Attachment1 = endAttachment
	beam.FaceCamera = true
	beam.Width0 = chargeRatio
	beam.Width1 = 0.5 * chargeRatio
	beam.LightInfluence = 0
	beam.Transparency = NumberSequence.new(0.5)
	beam.LightEmission = 1
	beam.Color = ColorSequence.new(Color3.fromRGB(62, 169, 255))
	beam.Parent = barrel

	Debris:AddItem(beam, 0.18)
	Debris:AddItem(startAttachment, 0.18)
	Debris:AddItem(endPart, 0.18)
end

local function fire(mouse, chargeRatio)
	if not isEquipped() or coolingDown then return end

	local handle = getHandle()
	if not handle then return end

	local target = mouse.Hit.Position
	local direction = target - handle.Position
	if direction.Magnitude <= 0 then return end

	local unitDirection = direction.Unit
	local result = workspace:Raycast(handle.Position, unitDirection * RANGE, makeRaycastParams())
	local fullRangePosition = handle.Position + unitDirection * RANGE
	local hitPosition = chargeRatio >= 0.98 and fullRangePosition or (result and result.Position or fullRangePosition)

	playShotSound(chargeRatio)
	muzzleFlash(chargeRatio)
	showShotBeam(handle, hitPosition, chargeRatio)

	shootEvent:FireServer(result and result.Instance or nil, unitDirection, chargeRatio)

	coolingDown = true
	cooldownStartedAt = os.clock()

	task.delay(COOLDOWN, function()
		coolingDown = false
	end)
end

local mouse = player:GetMouse()

mouse.Button1Down:Connect(function()
	if not isEquipped() or charging then return end

	if coolingDown then
		playCooldownSound()
		return
	end

	charging = true
	charged = false
	chargeStartedAt = os.clock()
	startChargeSound()
	startHandlePulse()

	task.delay(CHARGE_TIME, function()
		if charging and isEquipped() then
			charged = true
			stopHandlePulse(Enum.Material.Neon)
		end
	end)
end)

mouse.Button1Up:Connect(function()
	if not charging then return end

	local chargeRatio = getChargeRatio()

	charging = false
	charged = false
	stopChargeSound()
	stopHandlePulse(Enum.Material.Metal)

	fire(mouse, chargeRatio)
end)

tool.Equipped:Connect(function()
	chargeGui.Enabled = true
	setChargeHud(1, READY_COLOR)
end)

tool.Unequipped:Connect(function()
	charging = false
	charged = false
	chargeStartedAt = 0
	chargeGui.Enabled = false
	stopHandlePulse(Enum.Material.Metal)
	stopChargeSound()
end)]]></ProtectedString>
