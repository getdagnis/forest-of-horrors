		<Item class="Script" referent="RBX4b5fa73ad8d64921aeaa22b5bd16ac43">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent

-- Collect every physical part of the tool (Handle, Barrel, Grip, ...).
local parts = {}
for _, child in tool:GetDescendants() do
	if child:IsA("BasePart") then
		table.insert(parts, child)
	end
end

-- Anchor all parts while the tool sits in the workspace so it stays put.
-- The moment it's equipped (parented to a character), unanchor everything so
-- the whole gun follows the hand instead of freezing the character in place.
local function updateAnchored()
	local parent = tool.Parent
	local isEquipped = parent and parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") ~= nil
	for _, part in parts do
		part.Anchored = not isEquipped
		if isEquipped then
			-- Prevent tool parts from triggering teleport parts or colliding with the world
			part.CanTouch = false
			part.Massless = true
			part.CanCollide = false
		else
			part.CanTouch = true
			part.Massless = false
			part.CanCollide = true
		end
	end
end

tool.AncestryChanged:Connect(updateAnchored)
updateAnchored()]]></ProtectedString>
