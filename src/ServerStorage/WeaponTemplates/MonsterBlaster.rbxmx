		<Item class="LocalScript" referent="RBX4f7a78d2df77452b9d55bc4757dc210d">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local tool = script.Parent

local hud
local followMouse

tool.Equipped:Connect(function(mouse)
	local playerGui = player:WaitForChild("PlayerGui")

	local existing = playerGui:FindFirstChild("MonsterGunHud")
	if existing then
		existing:Destroy()
	end

	hud = tool:WaitForChild("WeaponHud"):Clone()
	hud.Name = "MonsterGunHud"
	hud.Parent = playerGui

	-- MonsterGun has no magazine/reload system.
	local ammoHud = hud:FindFirstChild("AmmoHud")
	if ammoHud then
		ammoHud.Visible = false
	end

	UserInputService.MouseIconEnabled = false

	followMouse = RunService.RenderStepped:Connect(function()
		hud.Crosshair.Position = UDim2.new(0, mouse.X, 0, mouse.Y)
	end)
end)

tool.Unequipped:Connect(function()
	if followMouse then
		followMouse:Disconnect()
		followMouse = nil
	end

	UserInputService.MouseIconEnabled = true

	if hud then
		hud:Destroy()
		hud = nil
	end
end)]]></ProtectedString>
