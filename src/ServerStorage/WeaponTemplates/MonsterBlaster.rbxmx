		<Item class="Script" referent="RBX2c2099e686654c43941cfdcf13d5ae6e">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local tool = script.Parent
local RESPAWN_DELAY = 12

-- Remember this gun's original world position and contents.
local spawnCFrame = tool:GetPivot()
local template = tool:Clone()
local originalParent = tool.Parent
local respawnScheduled = false

local function isPickedUp()
	local parent = tool.Parent

	return parent and (
		(parent:IsA("Backpack") and parent.Parent:IsA("Player"))
			or
			(parent:IsA("Model") and Players:GetPlayerFromCharacter(parent) ~= nil)
	)
end
	
tool.AncestryChanged:Connect(function()
	if respawnScheduled or not isPickedUp() then
		return
	end

	respawnScheduled = true

	task.delay(RESPAWN_DELAY, function()
		local replacement = template:Clone()
		replacement:PivotTo(spawnCFrame)
		replacement.Parent = originalParent
	end)
end)]]></ProtectedString>
